pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "DOCKER_IMAGE = "sagarteli/devopsexamapp:latest""
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Git Checkout') {
            steps {
                echo "📦 Checking out source code..."
                git url: 'https://github.com/sagarteli1214/3tierapplicationdeplyDevSecOps.git',
                    branch: 'master'
            }
        }

        stage('Install Trivy') {
            steps {
                sh '''
                echo "🔧 Installing Trivy..."
                curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
                | sh -s -- -b /usr/local/bin

                trivy --version
                '''
            }
        }

        stage('File System Scan') {
            steps {
                echo "🔍 Running Trivy File System Scan..."
                sh '''
                trivy fs --scanners vuln,misconfig \
                --format table \
                -o trivy-fs-report.html .
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "🧠 Running SonarQube Code Analysis..."
                withSonarQubeEnv('sonar') {
                    sh """
                    ${SCANNER_HOME}/bin/sonar-scanner \
                    -Dsonar.projectKey=devops-exam-app \
                    -Dsonar.projectName=devops-exam-app \
                    -Dsonar.sources=. \
                    -Dsonar.host.url=http://localhost:9000
                    """
                }
            }
        }

        stage('Verify Docker') {
            steps {
                sh '''
                docker --version || exit 1
                docker compose version || echo "⚠ Docker Compose not available"
                '''
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                dir('backend') {
                    script {
                        echo "🐳 Building and pushing Docker image..."

                        withDockerRegistry(credentialsId: 'docker') {
                            sh """
                            docker build -t ${DOCKER_IMAGE} .
                            docker push ${DOCKER_IMAGE}
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                trivy image --scanners vuln,misconfig \
                --format table \
                -o trivy-image-report.html \
                ${DOCKER_IMAGE}
                """
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                sh '''
                echo "🚀 Deploying with Docker Compose..."

                docker compose down --remove-orphans || true
                docker compose up -d --build || true

                echo "⏳ Waiting for MySQL..."
                sleep 10
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                echo "=== Container Status ==="
                docker compose ps || true

                echo "=== App Check ==="
                curl -I http://localhost:5000 || true
                '''
            }
        }
    }

    post {

        success {
            echo "🎉 Deployment successful!"
            sh 'docker compose ps || true'

            archiveArtifacts artifacts: 'trivy-fs-report.html', allowEmptyArchive: true
            archiveArtifacts artifacts: 'trivy-image-report.html', allowEmptyArchive: true
        }

        failure {
            echo "❌ Pipeline failed"

            sh '''
            echo "=== Debug Logs ==="
            docker compose logs --tail=50 || true
            '''
        }

        always {
            echo "📋 Final cleanup logs"

            sh '''
            docker compose logs --tail=20 || true
            '''

            archiveArtifacts artifacts: 'trivy-fs-report.html', allowEmptyArchive: true
            archiveArtifacts artifacts: 'trivy-image-report.html', allowEmptyArchive: true
        }
    }
}
